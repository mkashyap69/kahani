# ---------- Core infrastructure ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kahani
REDIS_URL=redis://localhost:6379
# 32+ char secret used to encrypt OAuth tokens and API keys at rest (AES-256-GCM)
ENCRYPTION_KEY=change-me-to-a-long-random-string-of-32-chars-min
# Public base URL of the web app (used for the YouTube OAuth redirect)
APP_URL=http://localhost:3000

# ---------- Object storage ----------
# STORAGE_DRIVER=local stores assets under ./data/storage (no MinIO needed)
# STORAGE_DRIVER=s3 uses any S3-compatible store (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kahani
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---------- Providers ----------
# auto = use a real provider when its key is configured, otherwise the offline mock
# mock = always offline mocks (free, for development / CI)
# live = always real providers (fails if a key is missing)
PROVIDER_MODE=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VISION_MODEL=gemini-2.5-flash
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
FAL_KEY=
FAL_LIPSYNC_MODEL=veed/fabric-1.0

# ---------- YouTube ----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---------- Worker tuning ----------
IMAGE_CONCURRENCY=4
TTS_CONCURRENCY=6
MOTION_CONCURRENCY=2
FFMPEG_PRESET=veryfast
USD_TO_INR=88
